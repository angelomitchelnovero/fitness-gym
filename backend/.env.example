# --- App ---
APP_ENV=development
APP_NAME=FitnessGym
APP_VERSION=0.1.0
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Database ---
DATABASE_URL=postgresql+psycopg://gym:gym@localhost:5432/fitness_gym

# --- Auth ---
JWT_SECRET=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Mail (Mailpit) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@fitnessgym.example
SMTP_FROM_NAME=FitnessGym

# --- Frontend URL (used in emails) ---
FRONTEND_URL=http://localhost:5173
